# 设备代号与内核架构
DEVICE="wayne"
ARCH="arm64"

# 适配 LineageOS 21.0 的 4.19 内核源码仓库与分支
KERNEL_REPO="https://github.com/xiaoleGun/android_kernel_xiaomi_wayne-4.19"
KERNEL_BRANCH="lineage-21"

# 配置文件与目标镜像格式
KERNEL_DEFCONFIG="vendor/wayne_defconfig"
KERNEL_IMAGE_NAME="Image.gz-dtb"

# 构建工具链选项（4.19 内核适配）
CLANG_VERSION="r450784e"
ENABLE_LTO="false"
